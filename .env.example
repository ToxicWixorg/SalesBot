# Telegram Bot Token
# Get from @BotFather
BOT_TOKEN=your_bot_token_here

# Database Configuration
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Redis Configuration (for caching and locks)
REDIS_HOST=localhost
REDIS_PORT=6379

# Support Forum Group Configuration
# Chat ID of your Telegram Forum Group (starts with -100)
# Leave empty to disable forum integration
SUPPORT_GROUP_ID=-1001234567890

# Topic IDs in the Forum Group
# Default values - adjust based on your forum setup
SUPPORT_TOPIC_ID=2    # General support tickets topic
ORDERS_TOPIC_ID=3     # Order-related tickets topic
REPORTS_TOPIC_ID=4    # Problem reports topic

# Environment
NODE_ENV=development

